<mujoco model="point_mass_attractor">
  <compiler angle="radian" inertiafromgeom="true" />
  <option timestep="0.05" gravity="0 0 0" integrator="Euler" />
  <default>
    <joint armature="0" damping="0" limited="false" />
    <geom contype="0" conaffinity="0" />
  </default>
  <worldbody>
    <body name="pointmass" pos="0 0 0">
      <joint name="slidex" type="slide" pos="0 0 0" axis="1 0 0" />
      <joint name="slidey" type="slide" pos="0 0 0" axis="0 1 0" />
      <geom name="ball" type="sphere" size="0.05" pos="0 0 0" rgba="0.8 0.3 0.3 1" mass="1" />
    </body>
  </worldbody>
  <actuator>
    <motor name="force_x" joint="slidex" gear="1" ctrlrange="-1 1" ctrllimited="true" />
    <motor name="force_y" joint="slidey" gear="1" ctrlrange="-1 1" ctrllimited="true" />
  </actuator>
</mujoco>
